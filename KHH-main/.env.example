# Primary canonical domain; set this in deployment when the site domain changes.
VITE_SITE_URL=https://khh-weld.vercel.app
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=

# Firebase web config: console > Project settings > Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# WhatsApp bridge: the deployed service URL and the key from whatsapp-bridge/.env
VITE_WHATSAPP_BRIDGE_URL=
VITE_WHATSAPP_BRIDGE_API_KEY=
